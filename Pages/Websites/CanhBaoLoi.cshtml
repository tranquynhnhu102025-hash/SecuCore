@page
@model SecuCore.Pages.Websites.CanhBaoLoiModel
@{
    ViewData["Title"] = "Cảnh báo Lỗ hổng";
}

<style>
    /* 1. Nền tổng thể tối và phẳng */
    body {
        background-color: #0d1117 !important;
        color: #c9d1d9 !important;
    }

    /* 2. Các khối Card phẳng chuẩn Cyber */
    .cyber-panel {
        background-color: #161b22 !important;
        border: 1px solid #30363d !important;
        border-radius: 8px !important;
        padding: 20px;
        box-shadow: none !important;
    }

    /* 3. Bảng dữ liệu chuẩn màu */
    .table-cyber {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

        .table-cyber thead, .table-cyber th, .table-cyber tr {
            background-color: transparent !important;
        }

        .table-cyber th {
            color: #8b949e !important;
            font-size: 0.75rem !important;
            font-weight: 600 !important;
            text-transform: uppercase !important;
            padding: 12px 10px !important;
            border-bottom: 1px solid #30363d !important;
        }

        .table-cyber td {
            padding: 15px 10px !important;
            border-bottom: 1px solid #21262d !important;
            vertical-align: middle !important;
            color: #c9d1d9 !important;
            background-color: transparent !important;
        }

    /* 4. Nút Xuất Báo Cáo Neon */
    .btn-neon-red {
        background-color: transparent !important;
        color: #ff7b72 !important;
        border: 1px solid #ff7b72 !important;
        border-radius: 4px;
        transition: 0.3s;
    }

        .btn-neon-red:hover {
            background-color: rgba(255, 123, 114, 0.1) !important;
        }
</style>

<div class="container-fluid mt-4 mb-5">

    <!-- TIÊU ĐỀ TRANG -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-uppercase m-0" style="color: #ff7b72; letter-spacing: 1px; text-shadow: 0 0 15px rgba(255, 123, 114, 0.3);">
                <i class="fa-solid fa-triangle-exclamation me-2"></i> CẢNH BÁO LỖ HỔNG
            </h3>
            <p class="mt-1 text-secondary" style="font-size: 0.85rem; letter-spacing: 1.5px; text-transform: uppercase;">
                <i class="fa-solid fa-shield-virus me-1" style="color: #ff7b72;"></i> Theo dõi và phát hiện mã độc thời gian thực
            </p>
        </div>
        <button class="btn btn-sm btn-neon-red fw-bold px-3 py-2" id="btnExport">
            <i class="fa-solid fa-file-pdf me-1"></i> XUẤT BÁO CÁO
        </button>
    </div>

    <!-- 4 THẺ THỐNG KÊ SỐ LIỆU -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="cyber-panel" style="border-top: 3px solid #ff003c !important;">
                <div class="text-secondary mb-1" style="font-size: 0.8rem;">NGHIÊM TRỌNG (CRITICAL)</div>
                <h3 class="text-light fw-bold m-0" style="color: #ff003c;">12</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="cyber-panel" style="border-top: 3px solid #ffaa00 !important;">
                <div class="text-secondary mb-1" style="font-size: 0.8rem;">CAO (HIGH)</div>
                <h3 class="text-light fw-bold m-0" style="color: #ffaa00;">34</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="cyber-panel" style="border-top: 3px solid #58a6ff !important;">
                <div class="text-secondary mb-1" style="font-size: 0.8rem;">TRUNG BÌNH (MEDIUM)</div>
                <h3 class="text-light fw-bold m-0" style="color: #58a6ff;">89</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="cyber-panel" style="border-top: 3px solid #2ea043 !important;">
                <div class="text-secondary mb-1" style="font-size: 0.8rem;">THẤP (LOW)</div>
                <h3 class="text-light fw-bold m-0" style="color: #2ea043;">156</h3>
            </div>
        </div>
    </div>

    <!-- BẢNG RADAR PHÁT HIỆN LỖ HỔNG TỪ SQL -->
    <div class="cyber-panel">
        <h5 class="text-light fw-bold pb-3 mb-2" style="border-bottom: 1px solid #30363d; font-size: 1rem; letter-spacing: 1px;">
            <i class="fa-solid fa-radar me-2" style="color: #00f0ff;"></i> RADAR PHÁT HIỆN MỚI NHẤT
        </h5>

        <div class="table-responsive">
            <table class="table table-borderless table-cyber table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 120px;">Mức độ</th>
                        <th style="width: 140px;">Thời gian</th>
                        <th>Tên lỗ hổng</th>
                        <th>Mục tiêu</th>
                        <th style="width: 150px;">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DanhSachLoi != null && Model.DanhSachLoi.Any())
                    {
                        @foreach (var log in Model.DanhSachLoi)
                        {
                            string badgeBg = log.Severity == "CRITICAL" ? "rgba(255,0,60,0.15)" : "rgba(255,170,0,0.15)";
                            string badgeColor = log.Severity == "CRITICAL" ? "#ff003c" : "#ffaa00";

                            <tr>
                                <td>
                                    <span class="badge" style="background: @badgeBg; color: @badgeColor; border: 1px solid @badgeColor; font-size: 0.75rem;">
                                        @log.Severity
                                    </span>
                                </td>
                                <td style="color: #8b949e; font-size: 0.85rem;">@log.ScanTime</td>
                                <td class="fw-bold text-light" style="color: #ffffff !important;">@log.VulnName</td>
                                <td class="font-monospace" style="color: #58a6ff !important; font-size: 0.85rem;">@log.TargetPath</td>
                                <td>
                                    @if (log.Status == "Đang tấn công")
                                    {
                                        <span style="color: #ff003c; font-size: 0.85rem; font-weight: 500;">
                                            <i class="fa-solid fa-circle text-danger me-1" style="font-size: 0.5rem;"></i> @log.Status
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="color: #ffaa00; font-size: 0.85rem; font-weight: 500;">
                                            <i class="fa-solid fa-triangle-exclamation me-1"></i> @log.Status
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="text-center text-secondary py-4">Chưa có cảnh báo lỗ hổng nào từ hệ thống.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- THƯ VIỆN & SCRIPT XỬ LÝ -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const btnExport = document.getElementById('btnExport');

        if (btnExport) {
            btnExport.addEventListener('click', function (e) {
                e.preventDefault();

                // Hiệu ứng chạy % biên dịch file giả lập rồi chuyển hướng sang trang Reports
                Swal.fire({
                    title: 'ĐANG BIÊN DỊCH BÁO CÁO...',
                    html: 'Hệ thống đang xuất file bảo mật định dạng PDF (<b>0%</b>)',
                    icon: 'info',
                    background: '#161b22',
                    color: '#c9d1d9',
                    allowOutsideClick: false,
                    showConfirmButton: false,
                    timer: 2000,
                    timerProgressBar: true,
                    didOpen: () => {
                        Swal.showLoading();
                        let timerInterval = setInterval(() => {
                            let content = Swal.getHtmlContainer();
                            if (content) {
                                let bTag = content.querySelector('b');
                                if (bTag) {
                                    let currentNum = parseInt(bTag.innerText);
                                    if (currentNum < 90) {
                                        bTag.innerText = (currentNum + 30) + '%';
                                    }
                                }
                            }
                        }, 400);
                    }
                }).then(() => {
                    // Chuyển hướng sang trang Xuất Báo Cáo (/Websites/Reports)
                    window.location.href = '/Websites/Reports';
                });
            });
        }
    });
</script>