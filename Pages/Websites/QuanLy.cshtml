@page
@{
    ViewData["Title"] = "Quản lý Website";
}
<div class="container-fluid mt-4 mb-5">
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="mini-stat-card stat-blue">
                <div>
                    <div class="text-secondary mb-1" style="font-size: 0.9rem;">Tổng Mục Tiêu</div>
                    <h3 class="text-light m-0 fw-bold">24 <span style="font-size: 1rem; color: #00f0ff;">Websites</span></h3>
                </div>
                <i class="fa-solid fa-server fa-2x" style="color: rgba(0, 240, 255, 0.2);"></i>
            </div>
        </div>
        <div class="col-md-4">
            <div class="mini-stat-card stat-green">
                <div>
                    <div class="text-secondary mb-1" style="font-size: 0.9rem;">Trạng thái An toàn</div>
                    <h3 class="text-light m-0 fw-bold">18 <span style="font-size: 1rem; color: #2ea043;">Đang bảo vệ</span></h3>
                </div>
                <i class="fa-solid fa-shield-check fa-2x" style="color: rgba(46, 160, 67, 0.2);"></i>
            </div>
        </div>
        <div class="col-md-4">
            <div class="mini-stat-card stat-red">
                <div>
                    <div class="text-secondary mb-1" style="font-size: 0.9rem;">Cần chú ý</div>
                    <h3 class="text-light m-0 fw-bold">06 <span style="font-size: 1rem; color: #ff003c;">Có rủi ro</span></h3>
                </div>
                <i class="fa-solid fa-triangle-exclamation fa-2x" style="color: rgba(255, 0, 60, 0.2);"></i>
            </div>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-xl-8 col-lg-7">
            <div class="cyber-panel d-flex flex-column" style="height: 100%; min-height: 600px;">

                <div class="d-flex justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 1px solid #30363d;">
                    <div class="cyber-search-wrapper">
                        <i class="fa-solid fa-magnifying-glass search-icon"></i>
                        <input type="text" class="cyber-search" placeholder="Nhập IP hoặc Tên miền...">
                    </div>
                    <div>
                        <button class="btn btn-sm btn-neon-blue fw-bold px-3 py-2">
                            <i class="fa-solid fa-plus-bolt me-1"></i> THÊM MỚI
                        </button>
                    </div>
                </div>

                <div class="table-responsive flex-grow-1">
                    <table class="table table-borderless table-cyber table-hover align-middle">
                        <thead>
                            <tr>
                                <th style="width: 30px;"><input class="form-check-input cyber-checkbox" type="checkbox"></th>
                                <th>Mục tiêu</th>
                                <th>IP Address</th>
                                <th>Bảo mật</th>
                                <th>Trạng thái</th>
                                <th class="text-center">Điều khiển</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><input class="form-check-input cyber-checkbox" type="checkbox"></td>
                                <td>
                                    <div class="fw-bold text-light"><i class="fa-solid fa-globe me-2" style="color: #58a6ff;"></i> qlsv.ntt.edu.vn</div>
                                    <small class="text-secondary" style="font-size: 0.75rem;">Hệ thống QL Sinh viên</small>
                                </td>
                                <td class="font-monospace" style="color: #8b949e; font-size: 0.85rem;">103.14.232.12</td>
                                <td>
                                    <div class="d-flex justify-content-between" style="width: 80px; font-size: 0.75rem;">
                                        <span class="text-light">Tốt</span> <span style="color: #2ea043;">98%</span>
                                    </div>
                                    <div class="health-bar"><div class="health-fill" style="width: 98%; background: #2ea043; box-shadow: 0 0 8px #2ea043;"></div></div>
                                </td>
                                <td><span class="badge" style="background: rgba(46,160,67,0.15); color: #3fb950; border: 1px solid #2ea043;">An toàn</span></td>
                                <td class="text-center">
                                    <i class="fa-solid fa-radar action-icon scan text-secondary" title="Quét sâu"></i>
                                    <i class="fa-solid fa-pen-to-square action-icon edit text-secondary" title="Cấu hình"></i>
                                    <i class="fa-solid fa-trash action-icon delete text-secondary" title="Gỡ bỏ"></i>
                                </td>
                            </tr>
                            <tr>
                                <td><input class="form-check-input cyber-checkbox" type="checkbox"></td>
                                <td>
                                    <div class="fw-bold text-light"><i class="fa-solid fa-globe me-2" style="color: #58a6ff;"></i> elearning.ntt.edu.vn</div>
                                    <small class="text-secondary" style="font-size: 0.75rem;">Cổng học trực tuyến</small>
                                </td>
                                <td class="font-monospace" style="color: #8b949e; font-size: 0.85rem;">103.14.232.45</td>
                                <td>
                                    <div class="d-flex justify-content-between" style="width: 80px; font-size: 0.75rem;">
                                        <span class="text-light">Cảnh báo</span> <span style="color: #ffaa00;">65%</span>
                                    </div>
                                    <div class="health-bar"><div class="health-fill" style="width: 65%; background: #ffaa00; box-shadow: 0 0 8px #ffaa00;"></div></div>
                                </td>
                                <td><span class="badge" style="background: rgba(255,170,0,0.15); color: #ffaa00; border: 1px solid #ffaa00;">Cảnh báo</span></td>
                                <td class="text-center">
                                    <i class="fa-solid fa-radar action-icon scan text-secondary" title="Quét sâu"></i>
                                    <i class="fa-solid fa-pen-to-square action-icon edit text-secondary" title="Cấu hình"></i>
                                    <i class="fa-solid fa-trash action-icon delete text-secondary" title="Gỡ bỏ"></i>
                                </td>
                            </tr>
                            <tr>
                                <td><input class="form-check-input cyber-checkbox" type="checkbox"></td>
                                <td>
                                    <div class="fw-bold text-light"><i class="fa-solid fa-globe me-2" style="color: #58a6ff;"></i> crm.doanhnghiep.vn</div>
                                    <small class="text-secondary" style="font-size: 0.75rem;">Máy chủ CRM</small>
                                </td>
                                <td class="font-monospace" style="color: #8b949e; font-size: 0.85rem;">192.168.1.100</td>
                                <td>
                                    <div class="d-flex justify-content-between" style="width: 80px; font-size: 0.75rem;">
                                        <span class="text-light">Nguy hiểm</span> <span style="color: #ff003c;">20%</span>
                                    </div>
                                    <div class="health-bar"><div class="health-fill" style="width: 20%; background: #ff003c; box-shadow: 0 0 8px #ff003c;"></div></div>
                                </td>
                                <td><span class="badge" style="background: rgba(255,0,60,0.15); color: #ff003c; border: 1px solid #ff003c;">Bị tấn công</span></td>
                                <td class="text-center">
                                    <i class="fa-solid fa-radar action-icon scan text-secondary" title="Quét sâu"></i>
                                    <i class="fa-solid fa-pen-to-square action-icon edit text-secondary" title="Cấu hình"></i>
                                    <i class="fa-solid fa-trash action-icon delete text-secondary" title="Gỡ bỏ"></i>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3 pt-3" style="border-top: 1px solid #30363d;">
                    <div class="d-flex align-items-center gap-2">
                        <select class="form-select form-select-sm cyber-select" style="width: 160px;">
                            <option selected>Hành động...</option>
                            <option value="1">Quét lỗ hổng</option>
                            <option value="3" class="text-danger">Xóa mục tiêu</option>
                        </select>
                        <button class="btn btn-sm btn-outline-info">Áp dụng</button>
                    </div>

                    <nav>
                        <ul class="pagination pagination-sm pagination-cyber mb-0">
                            <li class="page-item disabled"><a class="page-link" href="#"><i class="fa-solid fa-angles-left"></i></a></li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#"><i class="fa-solid fa-angles-right"></i></a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-lg-5">
            <div class="cyber-panel" style="height: 100%; min-height: 600px;">
                <h5 class="text-light fw-bold pb-3 mb-1" style="border-bottom: 1px solid #30363d; letter-spacing: 1px;">
                    <i class="fa-solid fa-satellite-dish me-2" style="color: #8b949e;"></i> NHẬT KÝ QUÉT
                    <span class="float-end blink-live" style="font-size: 0.8rem; margin-top: 4px;">
                        <i class="fa-solid fa-circle text-danger me-1" style="font-size: 0.6rem;"></i>LIVE
                    </span>
                </h5>

                <div class="cyber-timeline">
                    <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div class="timeline-time">13:10:30 (Vừa xong)</div>
                        <div class="timeline-text">
                            Đang phân tích gói tin HTTP Header tại mục tiêu <span class="timeline-target">crm.doanhnghiep.vn</span>...
                        </div>
                    </div>

                    <div class="timeline-item">
                        <div class="timeline-dot dot-warning"></div>
                        <div class="timeline-time">13:08:15</div>
                        <div class="timeline-text">
                            Phát hiện cổng 3306 (MySQL) đang mở không mã hóa tại <span class="timeline-target">elearning.ntt.edu.vn</span>.
                        </div>
                    </div>

                    <div class="timeline-item">
                        <div class="timeline-dot dot-danger"></div>
                        <div class="timeline-time">12:55:02</div>
                        <div class="timeline-text text-danger">
                            <i class="fa-solid fa-shield-virus me-1"></i> Chặn đứng nỗ lực chèn mã độc XSS từ IP <span class="font-monospace">171.244.x.x</span>
                        </div>
                    </div>

                    <div class="timeline-item">
                        <div class="timeline-dot dot-success"></div>
                        <div class="timeline-time">12:30:00</div>
                        <div class="timeline-text">
                            Hoàn tất kiểm tra bảo mật định kỳ cho hệ thống <span class="timeline-target">qlsv.ntt.edu.vn</span>. Kết quả: An toàn.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
      
        const btnAdd = document.querySelector('.btn-neon-blue');
        if (btnAdd) {
            btnAdd.addEventListener('click', function (e) {
                e.preventDefault(); // Ngăn trang web bị nhảy lên đầu (mất chữ #)
                alert("Tính năng 'Thêm Mới Website' yêu cầu quyền Admin cấp cao. Vui lòng liên hệ quản trị viên hệ thống!");
            });
        }

      
        const deleteIcons = document.querySelectorAll('.action-icon.delete');
        deleteIcons.forEach(icon => {
            icon.addEventListener('click', function () {
                if (confirm("⚠️ BẠN CÓ CHẮC CHẮN? \nHành động này sẽ xóa website khỏi danh sách giám sát an toàn thông tin!")) {
                    alert("Đã gửi yêu cầu gỡ bỏ hệ thống đến máy chủ bảo mật!");
                }
            });
        });

     
        const editIcons = document.querySelectorAll('.action-icon.edit');
        editIcons.forEach(icon => {
            icon.addEventListener('click', function () {
                alert("Đang tải dữ liệu... Đang chuyển hướng sang giao diện cấu hình Firewall!");
            });
        });

     
        const btnApply = document.querySelector('.btn-outline-info');
        if(btnApply) {
            btnApply.addEventListener('click', function(e) {
                e.preventDefault();
                alert("Đang áp dụng chính sách bảo mật hàng loạt...");
            });
        }
    });
</script>