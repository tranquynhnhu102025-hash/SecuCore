<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<!-- Thư viện để tải Excel -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<script>
    // --- TÍNH NĂNG XUẤT EXCEL ---
    function exportToExcel() {
        let table = document.getElementById('usersTable');
        let wb = XLSX.utils.table_to_book(table, {sheet: "Danh_Sach_Users"});
        XLSX.writeFile(wb, 'Danh_Sach_SecuCore_Users.xlsx');
    }

    // --- TÍNH NĂNG SẮP XẾP ---
    let sortAsc = true;
    function sortTable(columnIndex) {
        const table = document.getElementById("usersTable");
        let tbody = document.getElementById("tableBody");
        let rows = Array.from(tbody.querySelectorAll("tr"));

        rows.sort((a, b) => {
            let valA = a.cells[columnIndex].textContent.trim().toLowerCase();
            let valB = b.cells[columnIndex].textContent.trim().toLowerCase();
            if (valA < valB) return sortAsc ? -1 : 1;
            if (valA > valB) return sortAsc ? 1 : -1;
            return 0;
        });

        sortAsc = !sortAsc; // Đảo chiều cho lần bấm sau
        rows.forEach(row => tbody.appendChild(row));
        updatePagination(); // Sắp xếp xong thì vẽ lại phân trang
    }

    document.addEventListener("DOMContentLoaded", function () {
        const swalBg = '#161b22', swalText = '#c9d1d9', swalBorder = '#30363d';
        let userCounter = 7;

        const searchInput = document.getElementById('searchInput');
        const roleFilter = document.getElementById('roleFilter');
        const statusFilter = document.getElementById('statusFilter');

        // --- TÍNH NĂNG TÌM KIẾM & LỌC ĐA ĐIỀU KIỆN ---
        function filterTable() {
            const keyword = searchInput.value.toLowerCase();
            const roleKey = roleFilter.value;
            const statusKey = statusFilter.value;

            document.querySelectorAll('tbody tr').forEach(row => {
                const name = row.querySelector('.name-cell').textContent.toLowerCase();
                const email = row.querySelector('.email-cell').textContent.toLowerCase();
                const role = row.querySelector('.role-cell').textContent.trim();
                const status = row.querySelector('.status-cell').textContent.trim();

                let matchesSearch = name.includes(keyword) || email.includes(keyword);
                let matchesRole = (roleKey === "" || role === roleKey);
                let matchesStatus = (statusKey === "" || status === statusKey);

                if (matchesSearch && matchesRole && matchesStatus) {
                    row.classList.remove('d-none');
                } else {
                    row.classList.add('d-none');
                }
            });
            updatePagination(); // Lọc xong thì vẽ lại phân trang
        }

        searchInput.addEventListener('input', filterTable);
        roleFilter.addEventListener('change', filterTable);
        statusFilter.addEventListener('change', filterTable);

        // --- TÍNH NĂNG PHÂN TRANG ĐỘNG (REAL PAGINATION) ---
        const rowsPerPage = 5;
        let currentPage = 1;

        function updatePagination() {
            const tbody = document.getElementById('tableBody');
            // Lấy ra các hàng ĐANG HIỂN THỊ (không bị d-none do search)
            const visibleRows = Array.from(tbody.querySelectorAll('tr:not(.d-none)'));
            const totalPages = Math.ceil(visibleRows.length / rowsPerPage);
            const controls = document.getElementById('paginationControls');
            const noData = document.getElementById('noDataMessage');

            // Xử lý báo lỗi nếu không tìm thấy
            if(visibleRows.length === 0) {
                noData.style.display = 'block';
                controls.innerHTML = '';
                return;
            } else {
                noData.style.display = 'none';
            }

            // Đảm bảo currentPage không vượt quá tổng số trang hiện tại
            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;

            // Ẩn tất cả các dòng đang hiện
            visibleRows.forEach(row => row.style.display = 'none');

            // Chỉ hiện các dòng thuộc trang hiện tại
            const start = (currentPage - 1) * rowsPerPage;
            const end = start + rowsPerPage;
            visibleRows.slice(start, end).forEach(row => row.style.display = '');

            // Vẽ nút phân trang
            let html = '';

            // Nút Previous
            html += `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                        <a class="page-link" onclick="goToPage(${currentPage - 1})"><i class="fa-solid fa-angles-left"></i></a>
                     </li>`;

            // Các nút số
            for (let i = 1; i <= totalPages; i++) {
                html += `<li class="page-item ${currentPage === i ? 'active' : ''}">
                            <a class="page-link" onclick="goToPage(${i})">${i}</a>
                         </li>`;
            }

            // Nút Next
            html += `<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                        <a class="page-link" onclick="goToPage(${currentPage + 1})"><i class="fa-solid fa-angles-right"></i></a>
                     </li>`;

            controls.innerHTML = html;
        }

        // Hàm được gọi khi bấm số trang
        window.goToPage = function(page) {
            currentPage = page;
            updatePagination();
        }

        // Khởi chạy phân trang lần đầu
        updatePagination();

        // --- THÊM & SỬA XÓA --- (Giữ nguyên logic cũ, chỉ gọi thêm updatePagination khi thao tác xong)
        document.getElementById('btnAddUser').addEventListener('click', function () {
            Swal.fire({
                title: 'THÊM TÀI KHOẢN MỚI',
                html: `
                    <input id="swal-name" class="custom-swal-input" placeholder="Họ và tên...">
                    <input id="swal-email" type="email" class="custom-swal-input" placeholder="Email truy cập...">
                    <select id="swal-role" class="custom-swal-input" style="cursor: pointer;">
                        <option value="System Admin">System Admin</option>
                        <option value="Viewer" selected>Viewer</option>
                    </select>
                `,
                background: swalBg, color: swalText,
                showCancelButton: true, confirmButtonText: 'TẠO TÀI KHOẢN', cancelButtonText: 'HỦY',
                confirmButtonColor: '#00f0ff', cancelButtonColor: swalBorder
            }).then((result) => {
                if (result.isConfirmed) {
                    const newName = document.getElementById('swal-name').value;
                    const newEmail = document.getElementById('swal-email').value;
                    const newRole = document.getElementById('swal-role').value;

                    if(!newName || !newEmail) return Swal.fire({ icon:'error', title:'Thiếu thông tin!', background: swalBg, color: swalText});

                    userCounter++;
                    const newId = `#00${userCounter}`;
                    const badgeClass = newRole === 'System Admin' ? 'badge-admin' : 'badge-viewer';

                    const tbody = document.getElementById('tableBody');
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td class="text-secondary fw-bold">${newId}</td>
                        <td class="fw-bold text-light name-cell">${newName}</td>
                        <td class="text-secondary email-cell">${newEmail}</td>
                        <td class="text-center role-cell"><span class="badge-outline ${badgeClass}">${newRole}</span></td>
                        <td class="text-center status-cell"><span class="badge-outline badge-active">Hoạt động</span></td>
                        <td class="text-center">
                            <button class="btn-action btn-edit" title="Chỉnh sửa"><i class="fa-solid fa-pen-to-square"></i></button>
                            <button class="btn-action-danger btn-delete" title="Xóa"><i class="fa-solid fa-trash-can"></i></button>
                        </td>
                    `;
                    tbody.prepend(tr);
                    attachEventsToButtons(tr);
                    filterTable(); // Chạy lại bộ lọc và phân trang để hiện user mới

                    Swal.fire({ icon: 'success', title: 'Thành công!', text: 'Đã cấp quyền truy cập.', background: swalBg, color: swalText, confirmButtonColor: '#3fb950' });
                }
            });
        });

        function attachEventsToButtons(row) {
            const editBtn = row.querySelector('.btn-edit');
            if(editBtn) {
                editBtn.addEventListener('click', function() {
                    const id = row.cells[0].textContent.trim();
                    const name = row.querySelector('.name-cell').textContent.trim();
                    const email = row.querySelector('.email-cell').textContent.trim();
                    const role = row.querySelector('.role-cell').textContent.trim();

                    Swal.fire({
                        title: 'CHỈNH SỬA TÀI KHOẢN ' + id,
                        html: `
                            <input id="edit-name" class="custom-swal-input" value="${name}">
                            <input id="edit-email" type="email" class="custom-swal-input" value="${email}">
                            <select id="edit-role" class="custom-swal-input" style="cursor: pointer;">
                                <option value="System Admin" ${role === 'System Admin' ? 'selected' : ''}>System Admin</option>
                                <option value="Viewer" ${role === 'Viewer' ? 'selected' : ''}>Viewer</option>
                            </select>
                        `,
                        background: swalBg, color: swalText,
                        showCancelButton: true, confirmButtonText: 'LƯU', cancelButtonText: 'HỦY',
                        confirmButtonColor: '#00f0ff', cancelButtonColor: swalBorder
                    }).then((result) => {
                        if (result.isConfirmed) {
                            row.querySelector('.name-cell').textContent = document.getElementById('edit-name').value;
                            row.querySelector('.email-cell').textContent = document.getElementById('edit-email').value;
                            const newRole = document.getElementById('edit-role').value;
                            const badgeClass = newRole === 'System Admin' ? 'badge-admin' : 'badge-viewer';
                            row.querySelector('.role-cell').innerHTML = `<span class="badge-outline ${badgeClass}">${newRole}</span>`;
                            Swal.fire({ icon: 'success', title: 'Đã cập nhật!', background: swalBg, color: swalText, confirmButtonColor: '#3fb950' });
                        }
                    });
                });
            }

            const deleteBtn = row.querySelector('.btn-delete');
            if(deleteBtn) {
                deleteBtn.addEventListener('click', function() {
                    Swal.fire({
                        title: 'XÓA TÀI KHOẢN?',
                        text: "Hành động này sẽ thu hồi vĩnh viễn quyền truy cập!",
                        icon: 'warning',
                        background: swalBg, color: swalText,
                        showCancelButton: true, confirmButtonText: 'XÓA', cancelButtonText: 'HỦY',
                        confirmButtonColor: '#f85149', cancelButtonColor: swalBorder
                    }).then((result) => {
                        if (result.isConfirmed) {
                            row.remove();
                            filterTable(); // Vẽ lại phân trang sau khi xóa
                            Swal.fire({ icon: 'success', title: 'Đã xóa!', background: swalBg, color: swalText, confirmButtonColor: '#3fb950' });
                        }
                    });
                });
            }
        }

        document.querySelectorAll('tbody tr').forEach(row => attachEventsToButtons(row));
    });
</script>