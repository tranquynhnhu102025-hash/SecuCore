@page
@{
    ViewData["Title"] = "Quản lý Người dùng";
}

<style>
    /* CSS giữ nguyên form Cyberpunk siêu đẹp */
    ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }

    ::-webkit-scrollbar-track {
        background: #0d1117;
    }

    ::-webkit-scrollbar-thumb {
        background: #30363d;
        border-radius: 4px;
    }

        ::-webkit-scrollbar-thumb:hover {
            background: #58a6ff;
        }

    .cyber-card {
        background: #161b22;
        border: 1px solid #30363d;
        border-top: 3px solid #00f0ff;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.6), inset 0 0 20px rgba(0,240,255,0.05);
    }

    .page-title {
        color: #ffffff;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-shadow: 0 0 15px rgba(0, 240, 255, 0.4);
    }

    .btn-cyber-primary {
        background: linear-gradient(90deg, transparent, rgba(0, 240, 255, 0.1), transparent);
        color: #00f0ff;
        border: 1px solid #00f0ff;
        font-weight: 700;
        padding: 10px 20px;
        border-radius: 6px;
        transition: all 0.3s ease;
    }

        .btn-cyber-primary:hover {
            background: #00f0ff;
            color: #0d1117;
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.6);
            transform: translateY(-2px);
        }

    .btn-cyber-excel {
        background: transparent;
        color: #3fb950;
        border: 1px solid #3fb950;
        font-weight: 700;
        padding: 10px 20px;
        border-radius: 6px;
        transition: all 0.3s ease;
    }

        .btn-cyber-excel:hover {
            background: #3fb950;
            color: #0d1117;
            box-shadow: 0 0 20px rgba(63, 185, 80, 0.6);
            transform: translateY(-2px);
        }

    .cyber-input, .cyber-select {
        background: #0d1117 !important;
        border: 1px solid #30363d !important;
        color: #c9d1d9 !important;
        box-shadow: none !important;
        padding: 12px 15px;
    }

        .cyber-input:focus, .cyber-select:focus {
            border-color: #58a6ff !important;
            box-shadow: 0 0 15px rgba(88, 166, 255, 0.2) inset !important;
        }

    .input-group-text.cyber-bg {
        background: #161b22;
        border: 1px solid #30363d;
        color: #58a6ff;
        border-right: none;
    }

    .cyber-input {
        border-left: none;
    }

    input:-webkit-autofill, input:-webkit-autofill:hover, input:-webkit-autofill:focus, input:-webkit-autofill:active {
        -webkit-box-shadow: 0 0 0 30px #0d1117 inset !important;
        -webkit-text-fill-color: #c9d1d9 !important;
        transition: background-color 5000s ease-in-out 0s;
    }

    .table-cyber {
        color: #c9d1d9;
        margin-bottom: 0;
        border-collapse: separate;
        border-spacing: 0 8px;
    }

        .table-cyber, .table-cyber thead, .table-cyber tbody, .table-cyber tr, .table-cyber th, .table-cyber td {
            background-color: transparent !important;
        }

            .table-cyber th {
                color: #8b949e !important;
                font-size: 0.85rem;
                text-transform: uppercase;
                border-bottom: 1px solid #30363d !important;
                padding-bottom: 15px;
                font-weight: 700;
                letter-spacing: 1px;
                cursor: pointer;
                transition: 0.2s;
            }

                .table-cyber th:hover {
                    color: #58a6ff !important;
                }
            /* Hiệu ứng hover khi bấm Sắp xếp */

            .table-cyber td {
                border-bottom: 1px solid #30363d !important;
                border-top: 1px solid #30363d !important;
                padding: 18px 15px;
                vertical-align: middle;
            }

                .table-cyber td:first-child {
                    border-left: 3px solid #30363d !important;
                    border-top-left-radius: 8px;
                    border-bottom-left-radius: 8px;
                }

                .table-cyber td:last-child {
                    border-right: 1px solid #30363d !important;
                    border-top-right-radius: 8px;
                    border-bottom-right-radius: 8px;
                }

            .table-cyber tr:hover td {
                background: rgba(88, 166, 255, 0.08) !important;
            }

                .table-cyber tr:hover td:first-child {
                    border-left: 3px solid #58a6ff !important;
                    box-shadow: -5px 0 15px rgba(88,166,255,0.2);
                }

    .badge-outline {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 800;
        display: inline-block;
        text-align: center;
        min-width: 110px;
    }

    .badge-admin {
        border: 1px solid #58a6ff;
        color: #58a6ff;
        background: rgba(88, 166, 255, 0.1);
    }

    .badge-viewer {
        border: 1px solid #8b949e;
        color: #8b949e;
        background: rgba(139, 148, 158, 0.1);
    }

    .badge-active {
        border: 1px solid #3fb950;
        color: #3fb950;
        background: rgba(63, 185, 80, 0.1);
    }

    .badge-locked {
        border: 1px solid #f85149;
        color: #f85149;
        background: rgba(248, 81, 73, 0.1);
    }

    .btn-action, .btn-action-danger {
        background: #161b22;
        border: 1px solid #30363d;
        padding: 8px 12px;
        border-radius: 6px;
        margin: 0 3px;
    }

    .btn-action {
        color: #58a6ff;
    }

        .btn-action:hover {
            color: #0d1117;
            background: #58a6ff;
            border-color: #58a6ff;
            transform: translateY(-2px);
        }

    .btn-action-danger {
        color: #f85149;
    }

        .btn-action-danger:hover {
            color: #0d1117;
            background: #f85149;
            border-color: #f85149;
            transform: translateY(-2px);
        }

    .pagination .page-item .page-link {
        background-color: #161b22;
        border-color: #30363d;
        color: #8b949e;
        cursor: pointer;
        padding: 8px 16px;
        margin: 0 2px;
        border-radius: 4px;
    }

        .pagination .page-item .page-link:hover {
            background-color: #30363d;
            color: #58a6ff;
        }

    .pagination .page-item.active .page-link {
        background-color: #58a6ff !important;
        border-color: #58a6ff !important;
        color: #0d1117 !important;
        box-shadow: 0 0 10px rgba(88,166,255,0.4);
    }

    .pagination .page-item.disabled .page-link {
        background-color: #0d1117;
        color: #484f58;
        cursor: not-allowed;
    }

    div:where(.swal2-container) div:where(.swal2-popup) {
        border: 1px solid #30363d;
        border-top: 3px solid #58a6ff;
        background: #161b22 !important;
        border-radius: 12px !important;
    }

    .custom-swal-input {
        background: #0d1117 !important;
        color: #fff !important;
        border: 1px solid #30363d !important;
        border-radius: 6px;
        padding: 12px;
        margin: 10px auto;
        width: 80%;
        display: block;
    }

        .custom-swal-input:focus {
            border-color: #58a6ff !important;
            outline: none;
            box-shadow: 0 0 10px rgba(88,166,255,0.2) inset !important;
        }
</style>

