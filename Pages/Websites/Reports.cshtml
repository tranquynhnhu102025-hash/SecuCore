@page
@{
    ViewData["Title"] = "Kết xuất Báo cáo";
}

<style>
 
    .cyber-card {
        background: #161b22;
        border: 1px solid #30363d;
        border-radius: 8px;
        padding: 25px;
        height: 100%;
        box-shadow: inset 0 0 15px rgba(0,0,0,0.2);
    }

    .page-title {
        color: #fff;
        font-weight: bold;
        letter-spacing: 1px;
    }

    .page-subtitle {
        color: #8b949e;
        font-size: 0.9rem;
        margin-bottom: 25px;
    }

    .card-header-neon {
        color: #58a6ff;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 25px;
        border-bottom: 1px solid #30363d;
        padding-bottom: 15px;
    }

 
    .cyber-input, .cyber-select {
        background: #010409 !important;
        border: 1px solid #30363d !important;
        color: #c9d1d9 !important;
    }

        .cyber-input:focus, .cyber-select:focus {
            border-color: #58a6ff !important;
            box-shadow: 0 0 8px rgba(88, 166, 255, 0.2) !important;
        }

    .cyber-label {
        color: #8b949e;
        font-size: 0.85rem;
        margin-bottom: 8px;
        display: block;
    }

    
    .form-check-label {
        font-weight: bold;
        font-size: 0.9rem;
    }

    .check-red .form-check-input:checked {
        background-color: #ff003c;
        border-color: #ff003c;
    }

    .check-red .form-check-label {
        color: #ff7b72;
    }

    .check-yellow .form-check-input:checked {
        background-color: #ffaa00;
        border-color: #ffaa00;
    }

    .check-yellow .form-check-label {
        color: #e3b341;
    }

    .check-blue .form-check-input:checked {
        background-color: #00f0ff;
        border-color: #00f0ff;
    }

    .check-blue .form-check-label {
        color: #58a6ff;
    }

   
    .btn-export-pdf {
        background: #da3633;
        color: white;
        font-weight: bold;
        border: 1px solid #ff7b72;
        padding: 12px;
        transition: 0.3s;
    }

        .btn-export-pdf:hover {
            background: #ff003c;
            box-shadow: 0 0 15px rgba(255,0,60,0.5);
            color: white;
        }

    .btn-export-excel {
        background: #2ea043;
        color: white;
        font-weight: bold;
        border: 1px solid #3fb950;
        padding: 12px;
        transition: 0.3s;
    }

        .btn-export-excel:hover {
            background: #3fb950;
            box-shadow: 0 0 15px rgba(46,160,67,0.5);
            color: white;
        }

 
    .a4-preview-container {
        background: #010409;
        padding: 20px;
        border-radius: 4px;
        border: 1px dashed #30363d;
        overflow-y: auto;
        max-height: 650px;
        display: flex;
        justify-content: center;
    }

    .a4-paper {
        background: #ffffff;
        color: #000000;
        font-family: 'Times New Roman', Times, serif;
        width: 100%;
        max-width: 210mm;
        min-height: 297mm;
        padding: 40px 50px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.8);
    }

    .a4-header h4 {
        font-weight: bold;
        font-size: 1.3rem;
        text-align: center;
        margin-bottom: 5px;
    }

    .a4-header h3 {
        font-weight: bold;
        font-size: 1.5rem;
        text-align: center;
        margin-top: 20px;
        margin-bottom: 10px;
    }

    .a4-divider {
        border-bottom: 2px solid #000;
        margin: 15px 0 25px 0;
    }

    .a4-text {
        font-size: 1.1rem;
        line-height: 1.6;
        margin-bottom: 10px;
    }

    .table-a4 {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        font-size: 1.05rem;
    }

        .table-a4 th, .table-a4 td {
            border: 1px solid #000;
            padding: 8px 12px;
        }

        .table-a4 th {
            background: #f0f0f0;
            font-weight: bold;
            text-align: center;
            color: #000;
        }
</style>

<div class="container-fluid mt-4 mb-5">
    <h2 class="page-title"><i class="fa-solid fa-file-export me-2" style="color: #00f0ff;"></i> KẾT XUẤT BÁO CÁO</h2>
    <p class="page-subtitle">Trích xuất dữ liệu quét lỗ hổng và nhật ký hệ thống ra tài liệu.</p>

    <div class="row g-4">
        <!-- CỘT TRÁI: TIÊU CHÍ XUẤT -->
        <div class="col-lg-5">
            <div class="cyber-card">
                <div class="card-header-neon"><i class="fa-solid fa-filter me-2"></i> TIÊU CHÍ XUẤT BÁO CÁO</div>

                <div class="mb-4">
                    <label class="cyber-label">Loại báo cáo</label>
                    <select class="form-select cyber-select">
                        <option>Báo cáo Tổng hợp (Toàn hệ thống)</option>
                        <option>Báo cáo Chi tiết theo Mục tiêu</option>
                        <option>Báo cáo Lưu lượng mạng</option>
                    </select>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="cyber-label">Từ ngày</label>
                        <input type="date" class="form-control cyber-input">
                    </div>
                    <div class="col-md-6 mt-3 mt-md-0">
                        <label class="cyber-label">Đến ngày</label>
                        <input type="date" class="form-control cyber-input">
                    </div>
                </div>

                <div class="mb-5">
                    <label class="cyber-label mb-3">Mức độ nghiêm trọng cần xuất</label>
                    <div class="d-flex flex-wrap gap-4">
                        <div class="form-check check-red">
                            <input class="form-check-input" type="checkbox" checked id="chkCritical">
                            <label class="form-check-label" for="chkCritical">Critical (Đỏ)</label>
                        </div>
                        <div class="form-check check-yellow">
                            <input class="form-check-input" type="checkbox" checked id="chkWarning">
                            <label class="form-check-label" for="chkWarning">Warning (Vàng)</label>
                        </div>
                        <div class="form-check check-blue">
                            <input class="form-check-input" type="checkbox" checked id="chkInfo">
                            <label class="form-check-label" for="chkInfo">Info (Xanh)</label>
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-3 pt-3" style="border-top: 1px dashed #30363d;">
                    <button class="btn btn-export-pdf" id="btnExportPDF">
                        <i class="fa-solid fa-file-pdf me-2"></i> XUẤT FILE ĐỊNH DẠNG PDF
                    </button>
                    <button class="btn btn-export-excel" id="btnExportExcel">
                        <i class="fa-solid fa-file-excel me-2"></i> XUẤT FILE BẢNG TÍNH EXCEL
                    </button>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: PREVIEW A4 -->
        <div class="col-lg-7">
            <div class="cyber-card">
                <div class="card-header-neon"><i class="fa-solid fa-eye me-2"></i> XEM TRƯỚC TÀI LIỆU (PREVIEW)</div>

                <div class="a4-preview-container">
                    <!-- ID report-content để xuất PDF -->
                    <div class="a4-paper" id="report-content">
                        <div class="a4-header">
                            <h4>TRƯỜNG ĐẠI HỌC NGUYỄN TẤT THÀNH</h4>
                            <h4>HỆ THỐNG GIÁM SÁT AN NINH MẠNG SECUCORE</h4>
                            <h3>BÁO CÁO THỐNG KÊ LỖ HỔNG BẢO MẬT</h3>
                        </div>

                        <div class="a4-divider"></div>

                        <div class="a4-text"><strong>Người xuất báo cáo:</strong> Trần Quỳnh Như</div>
                        <div class="a4-text"><strong>Thời gian xuất:</strong> <span id="currentTime"></span></div>
                        <div class="a4-text mb-4"><strong>Giai đoạn thống kê:</strong> 01/06/2026 - Nay</div>

                        <h4 style="font-weight: bold; margin-top: 30px;">I. Tổng quan hệ thống:</h4>
                        <ul class="a4-text">
                            <li>Tổng số mục tiêu đang giám sát: 05 Website</li>
                            <li>Tổng số sự kiện mạng đã ghi nhận: 1,245 sự kiện</li>
                            <li>Trạng thái hệ thống: <span style="color: green; font-weight: bold;">Hoạt động ổn định</span></li>
                        </ul>

                        <h4 style="font-weight: bold; margin-top: 30px;">II. Chi tiết các lỗ hổng phát hiện:</h4>

                        <!-- ID report-table để xuất Excel -->
                        <table class="table-a4" id="report-table">
                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Loại tấn công</th>
                                    <th>Mức độ</th>
                                    <th>Số lượng</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="text-align: center;">1</td>
                                    <td>SQL Injection (SQLi)</td>
                                    <td style="color: red; font-weight: bold; text-align: center;">Critical</td>
                                    <td style="text-align: center;">03</td>
                                </tr>
                                <tr>
                                    <td style="text-align: center;">2</td>
                                    <td>Cross-Site Scripting (XSS)</td>
                                    <td style="color: #d49a00; font-weight: bold; text-align: center;">Warning</td>
                                    <td style="text-align: center;">15</td>
                                </tr>
                                <tr>
                                    <td style="text-align: center;">3</td>
                                    <td>Quét cổng mạng (Port Scan)</td>
                                    <td style="color: blue; font-weight: bold; text-align: center;">Info</td>
                                    <td style="text-align: center;">42</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- ==========================================
     THƯ VIỆN & SCRIPT TẠO FILE THẬT
     ========================================== -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Lấy giờ hiện tại đắp vào báo cáo
        const now = new Date();
        document.getElementById('currentTime').textContent = now.toLocaleString('vi-VN');

        const swalBg = '#161b22';
        const swalText = '#c9d1d9';

        // 1. TÍNH NĂNG XUẤT PDF THẬT
        const btnPDF = document.getElementById('btnExportPDF');
        if (btnPDF) {
            btnPDF.addEventListener('click', function(e) {
                e.preventDefault();

                // Hiện bảng Loading
                Swal.fire({
                    title: 'ĐANG KẾT XUẤT PDF...',
                    html: '<span style="color:#8b949e;">Hệ thống đang tổng hợp dữ liệu và tạo tệp tin...</span>',
                    background: swalBg, color: swalText,
                    allowOutsideClick: false,
                    didOpen: () => { Swal.showLoading() }
                });

                // Cấu hình in PDF cái bảng A4 (id="report-content")
                const element = document.getElementById('report-content');
                const opt = {
                    margin:       10, // lề 10mm
                    filename:     'BaoCao_SecuCore.pdf',
                    image:        { type: 'jpeg', quality: 0.98 },
                    html2canvas:  { scale: 2, useCORS: true },
                    jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
                };

                // Bắt đầu in và tải về máy
                html2pdf().set(opt).from(element).save().then(function() {
                    // Xong thì hiện Success
                    Swal.fire({
                        icon: 'success',
                        title: 'Hoàn tất!',
                        text: 'File BaoCao_SecuCore.pdf đã được tải xuống máy của bạn.',
                        background: swalBg, color: swalText,
                        confirmButtonColor: '#3fb950'
                    });
                });
            });
        }

        // 2. TÍNH NĂNG XUẤT EXCEL THẬT
        const btnExcel = document.getElementById('btnExportExcel');
        if (btnExcel) {
            btnExcel.addEventListener('click', function(e) {
                e.preventDefault();

                // Hiện bảng Loading
                Swal.fire({
                    title: 'ĐANG KẾT XUẤT EXCEL...',
                    html: '<span style="color:#8b949e;">Đang map dữ liệu vào bảng tính...</span>',
                    background: swalBg, color: swalText,
                    allowOutsideClick: false,
                    didOpen: () => { Swal.showLoading() }
                });

                // Tạo một cái delay nhẹ 0.5s để người dùng thấy cái bảng Loading chuyên nghiệp
                setTimeout(() => {
                    try {
                        const table = document.getElementById('report-table');
                        const wb = XLSX.utils.table_to_book(table, {sheet: "Bao_Cao_Loi"});
                        XLSX.writeFile(wb, 'Data_SecuCore.xlsx');

                        // Báo thành công
                        Swal.fire({
                            icon: 'success',
                            title: 'Hoàn tất!',
                            text: 'File Data_SecuCore.xlsx đã được tải xuống.',
                            background: swalBg, color: swalText,
                            confirmButtonColor: '#3fb950'
                        });
                    } catch (error) {
                        Swal.fire({ icon: 'error', title: 'Lỗi xuất file!', text: error.message, background: swalBg, color: swalText });
                    }
                }, 800);
            });
        }
    });
</script>