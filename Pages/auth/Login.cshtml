@page
@model SecuCore.Pages.auth.LoginModel
@{
	ViewData["Title"] = "Đăng nhập hệ thống";
	Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>@ViewData["Title"] - SecuCore</title>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
	<style>
		body {
			background-color: #0d1117;
			color: #c9d1d9;
			height: 100vh;
			display: flex;
			align-items: center;
			justify-content: center;
			font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
		}
		.cyber-card{
			background: #161b22;
			border: 1px solid #30363d;
			border-radius: 12px;
			padding: 40px 30px;
			width: 100%;
			max-width: 420px;
			box-shadow: 0 0 30px rgba( 88, 166, 255, 0.1);

		}
		.cyber-input /*ô nhập liệu tên và mật khẩu*/{
			background: #0d1117;
			border: 1px solid #30363d;
			color: #58a6ff;
		}
		.cyber-input:focus {
			background: #0d1117;
			border-color: #58a6ff;
			box-shadow: 0 0 8px rgba(88, 166, 255, 0.4);
			color: #58a6ff;
			}
		.input-group-text{
			background: #0d1117;
			border: 1px solid #30363d;
			color: #8b949e;
		}
		.cyber-btn{
			background: transparent;
			color: #58a6ff;
			text-transform: uppercase;
			font-weight: bold;
			width: 100%;
			padding: 10px;
			letter-spacing: 1px;
			transition: all 0.3s;
		}
        .cyber-btn:hover{
				background: #58a6ff;
				color: #0d1117;
				box-shadow: 0 0 15px rgba(88, 166, 255, 0.6);
		}
		</style>
		</head>
<body>	
	<a href="/Intro" class="text-decoration-none position-absolute" style="top: 25px; left: 30px; color: #8b949e; font-size: 0.9rem; letter-spacing: 1px; transition: all 0.3s; z-index: 999;" onmouseover="this.style.color='#58a6ff'; this.style.textShadow='0 0 10px rgba(88,166,255,0.5)';" onmouseout="this.style.color='#8b949e'; this.style.textShadow='none';">
		<i class="fa-solid fa-arrow-left-long me-2"></i> QUAY LẠI
	</a>
	<div class="cyber-card">
		<div class="text-center mb-4">
			<i class ="fa-solid fa-shield-halved fa-3x mb-3" style="color: #58a6ff; text-shadow: 0 0 15px rgba(88,166,255,0.5);"></i>  
			<h3 class="fw-bold text-light m-0" style="letter-spacing: 2px;">SECU<span style="color: #58a6ff;">CORE</span></h3>
			<p class="text-secondary mt-1" style="font-size: 0.85rem; letter-spacing: 1px;">HỆ THỐNG GIÁM SÁT AN NINH</p>
		</div>
		<form method="post">
            <div class="mb-3">
                <label class="form-label text-secondary" style="font-size: 0.85rem;">Tài khoản quản trị</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-user-shield"></i></span>
                    <input type="text" class="form-control cyber-input" placeholder="Nhập username..." required>
                </div>
			</div>
			<div class="mb-4">
				<label class="form-label text-secondary" style="font-size: 0.85rem;">Khóa bảo mật (Mật khẩu)</label>
				<div class="input-group">
					<span class="input-group-text"><i class="fa-solid fa-key"></i></span>
					<input type="password" class="form-control cyber-input" placeholder="••••••••••••" required>
				</div>
			</div>

			<button type="submit" class="btn cyber-btn mb-4">
				<i class="fa-solid fa-right-to-bracket me-2"></i> ỦY QUYỀN ĐĂNG NHẬP
			</button>

			<div class="text-center">
				<span class="text-secondary" style="font-size: 0.85rem;">Nhân sự mới? </span>
				<a href="/auth/Register" class="text-decoration-none fw-bold" style="color: #58a6ff; font-size: 0.85rem;">Yêu cầu cấp quyền</a>
			</div>
		</form>
	</div>
</body>
</html>
