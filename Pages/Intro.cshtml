@page
@{
    ViewData["Title"] = "Giới thiệu hệ thống";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SecuCore - Khởi động hệ thống</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            background-color: #050b14;
            color: #c9d1d9;
            font-family: 'Courier New', Courier, monospace;
            margin: 0;
            overflow-x: hidden;
            background-image: linear-gradient(rgba(88, 166, 255, 0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(88, 166, 255, 0.03) 1px, transparent 1px);
            background-size: 40px 40px;
        }

        #particles-js {
            position: fixed;
            width: 100vw;
            height: 100vh;
            top: 0;
            left: 0;
            z-index: 1;
        }

        .scanlines {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0) 50%, rgba(88, 166, 255, 0.03) 50%, rgba(88, 166, 255, 0.03));
            background-size: 100% 8px;
            pointer-events: none;
            z-index: 999;
        }

        .hero-section {
            position: relative;
            z-index: 10;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            padding-bottom: 50px;
        }

        .title-glow {
            color: #58a6ff;
            text-shadow: 0 0 25px rgba(88,166,255,0.8);
            font-weight: 900;
            letter-spacing: 6px;
            font-family: 'Segoe UI', sans-serif;
        }

        .cyber-btn-main {
            background: rgba(13, 17, 23, 0.8);
            color: #58a6ff;
            border: 2px solid #58a6ff;
            padding: 15px 40px;
            font-size: 1.1rem;
            font-weight: bold;
            text-transform: uppercase;
            border-radius: 4px;
            transition: all 0.3s;
            box-shadow: 0 0 15px rgba(88,166,255,0.2);
            text-decoration: none;
            display: inline-block;
            letter-spacing: 2px;
        }

            .cyber-btn-main:hover {
                background: #58a6ff;
                color: #0d1117;
                box-shadow: 0 0 35px rgba(88,166,255,0.9);
            }

        .feature-box {
            background: rgba(22, 27, 34, 0.7);
            border: 1px solid #30363d;
            border-top: 3px solid #58a6ff;
            padding: 25px 15px;
            border-radius: 8px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            backdrop-filter: blur(5px);
            width: 100%;
        }

            .feature-box:hover {
                transform: translateY(-10px);
                border-top-color: #3fb950;
                box-shadow: 0 10px 20px rgba(0,0,0,0.5);
            }

        /* Đã sửa lỗi ngắt dòng CSS gây liệt animation */
        .typewriter p {
            overflow: hidden;
            border-right: .15em solid #58a6ff;
            white-space: nowrap;
            margin: 0 auto;
            letter-spacing: .1em;
            animation: typing 3s steps(50, end) forwards, blink-caret .75s step-end infinite;
        }

        @@keyframes typing {
            from {
                width: 0;
            }

            to {
                width: 100%;
            }
        }

        @@keyframes blink-caret {
            from, to {
                border-color: transparent;
            }

            50% {
                border-color: #58a6ff;
            }
        }

        .fake-terminal {
            width: 100%;
            max-width: 800px;
            height: 120px;
            background: rgba(13, 17, 23, 0.6);
            border: 1px solid #30363d;
            border-radius: 5px;
            margin-top: 40px;
            padding: 10px;
            font-size: 0.8rem;
            color: #3fb950;
            overflow: hidden;
            text-align: left;
            position: relative;
        }

            .fake-terminal::before {
                content: "SYSTEM LOGS - [ACTIVE]";
                display: block;
                color: #8b949e;
                border-bottom: 1px dashed #30363d;
                padding-bottom: 5px;
                margin-bottom: 5px;
                font-size: 0.75rem;
            }

        #log-content {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
    </style>
</head>
<body>
    <div id="particles-js"></div>
    <div class="scanlines"></div>

    <div class="hero-section">
        <div class="container text-center">
            <i class="fa-solid fa-earth-americas fa-4x mb-3" style="color: #58a6ff; text-shadow: 0 0 30px rgba(88,166,255,0.5);"></i>
            <h1 class="display-4 title-glow mb-3">SECU<span class="text-white">CORE</span></h1>

            <div class="typewriter mb-3" style="max-width: 650px; margin: 0 auto; display: inline-block;">
                <p class="lead text-secondary" style="font-size: 1rem; margin-bottom: 0;">
                    > Initializing real-time security monitor..._
                </p>
            </div>
            <br>

            <a href="/auth/Login" class="cyber-btn-main mt-4 mb-5">
                <i class="fa-solid fa-terminal me-2"></i> KẾT NỐI MÁY CHỦ
            </a>

            <div class="row justify-content-center">
                <div class="col-md-4 mb-3">
                    <div class="feature-box">
                        <i class="fa-solid fa-satellite-dish fa-2x mb-2" style="color: #3fb950;"></i>
                        <h6 class="text-light fw-bold m-0">QUÉT LIÊN TỤC</h6>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="feature-box">
                        <i class="fa-solid fa-chart-line fa-2x mb-2" style="color: #ffaa00;"></i>
                        <h6 class="text-light fw-bold m-0">BÁO CÁO LIVE</h6>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="feature-box">
                        <i class="fa-solid fa-lock fa-2x mb-2" style="color: #ff003c;"></i>
                        <h6 class="text-light fw-bold m-0">BẢO MẬT RSA</h6>
                    </div>
                </div>
            </div>

            <!-- Khu vực Terminal ảo -->
            <div class="fake-terminal mx-auto">
                <div id="log-content"></div>
            </div>
        </div>
    </div>

    <!-- Script tạo hiệu ứng -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/particles.js/2.0.0/particles.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Cấu hình hạt bụi bay bay
            if (typeof particlesJS !== "undefined") {
                particlesJS("particles-js", {
                    "particles": {
                        "number": { "value": 70, "density": { "enable": true, "value_area": 800 } },
                        "color": { "value": "#58a6ff" },
                        "shape": { "type": "circle" },
                        "opacity": { "value": 0.5, "random": false },
                        "size": { "value": 3, "random": true },
                        "line_linked": { "enable": true, "distance": 150, "color": "#58a6ff", "opacity": 0.3, "width": 1 },
                        "move": { "enable": true, "speed": 1.5, "direction": "none", "random": false, "straight": false, "out_mode": "out", "bounce": false }
                    },
                    "interactivity": {
                        "detect_on": "canvas",
                        "events": { "onhover": { "enable": true, "mode": "grab" }, "onclick": { "enable": true, "mode": "push" }, "resize": true },
                        "modes": { "grab": { "distance": 140, "line_linked": { "opacity": 1 } }, "push": { "particles_nb": 4 } }
                    },
                    "retina_detect": true
                });
            }

            // Script tạo log chạy ảo ở dưới cùng
            const logs = [
                "Scanning port 80 on target 192.168.1.105...",
                "SUCCESS: Connection established via SSH.",
                "WARNING: Multiple failed login attempts detected from 45.33.x.x",
                "Encrypting data streams with AES-256...",
                "Analyzing payload integrity: OK.",
                "Firewall rule updated: Block subnet 10.0.0.0/8"
            ];
            const logContent = document.getElementById("log-content");

            setInterval(() => {
                if (logContent.children.length > 3) logContent.removeChild(logContent.firstChild);
                const newLog = document.createElement("div");
                newLog.innerText = "> [" + new Date().toLocaleTimeString() + "] " + logs[Math.floor(Math.random() * logs.length)];
                logContent.appendChild(newLog);
            }, 1200);
        });
    </script>
</body>
</html>