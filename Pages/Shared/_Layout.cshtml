<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SecuCore</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
    body {
    background-color: #0d1117;
    color: #c9d1d9;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    margin: 0;
    overflow-x: hidden;
    }

    .app-wrapper {
    display: flex;
    min-height: 100vh;
    }

    .sidebar {
    width: 280px;
    background-color: #161b22;
    border-right: 1px solid #30363d;
    display: flex;
    flex-direction: column;
    position: fixed;
    height: 100vh;
    z-index: 1000;
    top: 0;
    left: 0;
    }

    .sidebar-header {
    padding: 25px 20px;
    text-align: center;
    border-bottom: 1px solid #30363d;
    }

    .sidebar-menu {
    padding: 20px 15px;
    flex-grow: 1;
    overflow-y: auto;
    }

    .menu-item {
    display: flex;
    align-items: center;
    padding: 12px 15px;
    color: #8b949e;
    text-decoration: none;
    border-radius: 8px;
    margin-bottom: 8px;
    transition: all 0.3s ease;
    font-weight: 500;
    }

    .menu-item i {
    width: 25px;
    font-size: 1.1rem;
    }

    .menu-item:hover {
    background-color: rgba(88, 166, 255, 0.1);
    color: #58a6ff;
    }

    .menu-item.active {
    background-color: #1f6feb;
    color: #ffffff;
    box-shadow: 0 0 15px rgba(31, 111, 235, 0.4);
    }

    .sidebar-footer {
    padding: 20px 15px;
    border-top: 1px solid #30363d;
    background-color: #161b22;
    }

    .main-content {
    flex-grow: 1;
    margin-left: 280px;
    padding: 30px 40px;
    min-height: 100vh;
    background-image: radial-gradient(circle at top right, rgba(31, 111, 235, 0.05), transparent 40%);
    }
    </style>
</head>
<body>
    <div class="app-wrapper">
        <aside class="sidebar">
            <div class="sidebar-header">
                <h4 class="m-0 fw-bold" style="color: #c9d1d9; letter-spacing: 1px;">
                    <i class="fa-solid fa-shield-halved me-2" style="color: #58a6ff;"></i>SECU<span style="color: #58a6ff;">CORE</span>
                </h4>
            </div>
            <nav class="sidebar-menu">
                <a href="/Index" class="menu-item"><i class="fa-solid fa-house"></i> Home</a>
                <a href="/Websites/QuanLy" class="menu-item"><i class="fa-solid fa-globe"></i> Quản lý Website</a>
                <a href="/Websites/CanhBaoLoi" class="menu-item"><i class="fa-solid fa-triangle-exclamation"></i> Cảnh báo Lỗ hổng</a>
                <a href="/Websites/Settings" class="menu-item"><i class="fa-solid fa-gear"></i> Cài đặt</a>
                <a href="/Websites/Users" class="menu-item"><i class="fa-solid fa-users"></i> Quản lý Người dùng</a>
                <a href="/Websites/Reports" class="menu-item"><i class="fa-solid fa-file-export"></i> Xuất báo cáo</a>

                <!-- ĐÃ GHIM HỒ SƠ CÁ NHÂN LÊN MENU Ở ĐÂY -->
                <a href="/Websites/HoSoCaNhan" class="menu-item"><i class="fa-solid fa-address-book"></i> Hồ sơ Cá nhân</a>
            </nav>
            <div class="sidebar-footer">
                <div class="d-flex align-items-center justify-content-between">

                    <!-- Vẫn giữ link ở Avatar phòng khi quen tay bấm -->
                    <a href="/Websites/HoSoCaNhan " class="d-flex align-items-center gap-3 text-decoration-none" style="cursor: pointer; transition: 0.3s;" onmouseover="this.style.opacity='0.7'" onmouseout="this.style.opacity='1'">
                        <div style="width: 45px; height: 45px; border-radius: 50%; background: linear-gradient(135deg, #58a6ff, #1f6feb); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 1.2rem;">
                            @(User.Identity.Name != null ? User.Identity.Name.Substring(0, 1).ToUpper() : "A")
                        </div>
                        <div class="d-flex flex-column">
                            <span class="fw-bold" style="color: #c9d1d9; font-size: 0.95rem; max-width: 120px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                @(User.Identity.Name ?? "Admin NTT")
                            </span>
                            <span style="color: #3fb950; font-size: 0.75rem; margin-top: 2px;">
                                <i class="fa-solid fa-user-shield me-1"></i> System Manager
                            </span>
                        </div>
                    </a>

                    <!-- Nút Đăng xuất -->
                    <a href="/Intro" class="text-danger p-2 rounded" style="font-size: 1.2rem; transition: 0.3s;" onmouseover="this.style.background='rgba(220, 53, 69, 0.1)'" onmouseout="this.style.background='transparent'" title="Đăng xuất">
                        <i class="fa-solid fa-power-off"></i>
                    </a>
                </div>
            </div>
        </aside>
        <main class="main-content">
            @RenderBody()
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>