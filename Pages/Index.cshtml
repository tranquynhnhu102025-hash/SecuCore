@page
@model SecuCore.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .main-heading {
        font-weight: 800;
        letter-spacing: 1px;
        color: #ffffff;
        text-shadow: 0 0 20px rgba(88,166,255,0.3);
    }

    .cyber-card {
        background: #161b22;
        border: 1px solid #30363d;
        border-radius: 12px;
        padding: 25px;
        position: relative;
        overflow: hidden;
        height: 100%;
        transition: transform 0.3s;
    }

        .cyber-card:hover {
            transform: translateY(-5px);
        }

    .neon-blue {
        border-left: 4px solid #58a6ff;
        box-shadow: 0 5px 15px rgba(88,166,255,0.05);
    }

    .neon-red {
        border-left: 4px solid #ff7b72;
        box-shadow: 0 5px 15px rgba(255,123,114,0.05);
    }

    .neon-yellow {
        border-left: 4px solid #d29922;
        box-shadow: 0 5px 15px rgba(210,153,34,0.05);
    }

    .cyber-title {
        color: #8b949e;
        font-size: 0.9rem;
        text-transform: uppercase;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .cyber-number {
        font-size: 3rem;
        font-weight: 900;
        line-height: 1;
        margin-bottom: 5px;
    }

    .neon-blue .cyber-number {
        color: #58a6ff;
    }

    .neon-red .cyber-number {
        color: #ff7b72;
    }

    .neon-yellow .cyber-number {
        color: #d29922;
    }

    .cyber-icon {
        position: absolute;
        right: 20px;
        top: 30px;
        font-size: 3.5rem;
        opacity: 0.1;
    }

    .cyber-panel {
        background: #161b22;
        border: 1px solid #30363d;
        border-radius: 12px;
        padding: 25px;
        height: 100%;
        box-shadow: 0 5px 20px rgba(0,0,0,0.2);
    }

    .cyber-panel-title {
        font-size: 1.1rem;
        font-weight: bold;
        border-bottom: 1px solid #30363d;
        padding-bottom: 15px;
        margin-bottom: 20px;
        color: #c9d1d9;
    }

    .table-cyber th {
        color: #8b949e;
        border-bottom: 1px solid #30363d;
        padding-bottom: 15px;
        font-weight: 600;
    }

    .table-cyber td {
        padding: 15px 0;
        border-bottom: 1px solid rgba(48,54,61,0.5);
        vertical-align: middle;
    }

    .table-cyber tr:last-child td {
        border-bottom: none;
    }

    .cyber-progress {
        height: 8px;
        background: #0d1117;
        border-radius: 10px;
        overflow: hidden;
    }
    /* Trị tận gốc cái bảng nền trắng */
    .table-cyber, .table-cyber tr, .table-cyber th, .table-cyber td {
        background-color: transparent !important;
        color: #c9d1d9 !important;
    }
</style>

<!-- TIÊU ĐỀ TRANG DASHBOARD -->
<div class="text-center mb-5 mt-2">
    <h2 class="fw-bold text-uppercase" style="letter-spacing: 2px;">
        <!-- Biểu tượng Radar phát sáng -->
        <i class="fa-solid fa-radar fa-spin-pulse me-2" style="color: #00f0ff; text-shadow: 0 0 15px rgba(0, 240, 255, 0.8);"></i>

        <!-- Chữ chuyển màu dải Neon -->
        <span style="background: linear-gradient(to right, #00f0ff, #58a6ff); -webkit-background-clip: text; color: transparent; text-shadow: 0 0 20px rgba(0, 240, 255, 0.2);">
            Trung tâm điều khiển SecuCore
        </span>
    </h2>
    <p class="mt-2" style="font-size: 0.85rem; letter-spacing: 3px; text-transform: uppercase; color: #8b949e;">
        <i class="fa-solid fa-shield-halved me-1" style="color: #58a6ff;"></i> Hệ thống giám sát và phân tích lỗ hổng bảo mật Website
    </p>

    <!-- Đường kẻ ngang trang trí mờ -->
    <div class="mx-auto mt-3" style="width: 150px; height: 2px; background: linear-gradient(to right, transparent, #30363d, transparent);"></div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="cyber-card neon-blue">
            <div class="cyber-title">Mục Tiêu Giám Sát</div>
            <div class="cyber-number">@Model.TongSoMucTieu.ToString("D2")</div>
            <div class="text-light opacity-50" style="font-size: 0.8rem;">Websites đang được bảo vệ</div>
            <i class="fa-solid fa-network-wired cyber-icon text-primary"></i>
        </div>
    </div>
    <div class="col-md-4">
        <div class="cyber-card neon-red">
            <div class="cyber-title">Lỗ Hổng Nguy Hiểm</div>
            <div class="cyber-number">@Model.SoLoHongNguyHiem.ToString("D2")</div>
            <div class="text-light opacity-50" style="font-size: 0.8rem;">Cần xử lý vá lỗi ngay lập tức</div>
            <i class="fa-solid fa-bug cyber-icon text-danger"></i>
        </div>
    </div>
    <div class="col-md-4">
        <div class="cyber-card neon-yellow">
            <div class="cyber-title">Cảnh Báo Security</div>
            <div class="cyber-number">@Model.SoCanhBao.ToString("D2")</div>
            <div class="text-light opacity-50" style="font-size: 0.8rem;">Truy cập bất thường trong 24h</div>
            <i class="fa-solid fa-triangle-exclamation cyber-icon text-warning"></i>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="cyber-panel d-flex flex-column">
            <div class="cyber-panel-title"><i class="fa-solid fa-list-check me-2" style="color: #58a6ff;"></i> Nhật Ký Quét Lỗ Hổng Gần Đây</div>
            <div class="table-responsive flex-grow-1">
                <table class="table table-borderless table-cyber mb-0 w-100">
                    <thead>
                        <tr>
                            <th>Thời gian</th>
                            <th>Mục tiêu quét (Target)</th>
                            <th>Phân loại</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DanhSachNhatKy != null && Model.DanhSachNhatKy.Any())
                        {
                            foreach (var log in Model.DanhSachNhatKy)
                            {
                                <tr>
                                    <!-- Đã sửa lỗi CS1503: Bỏ .ToString("HH:mm") vì ScanTime đã là chuỗi -->
                                    <td style="color: #8b949e;">@log.ScanTime</td>

                                    <!-- Đã sửa lỗi CS1061: Đổi TargetUrl thành TargetPath -->
                                    <td class="text-light fw-bold">@log.TargetPath</td>

                                    <td>
                                        <!-- Đã sửa lỗi CS1061: Đổi VulnerabilityType thành VulnName -->
                                        @if (!string.IsNullOrEmpty(log.VulnName) && (log.VulnName.Contains("SQL") || log.VulnName.Contains("DDoS") || log.Severity == "CRITICAL"))
                                        {
                                            <span class="badge" style="background: rgba(255, 123, 114, 0.2); color: #ff7b72; border: 1px solid #ff7b72;">@log.VulnName</span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background: rgba(210, 153, 34, 0.2); color: #d29922; border: 1px solid #d29922;">@log.VulnName</span>
                                        }
                                    </td>
                                    <td>
                                        <!-- Đã sửa lỗi CS1061: Đổi IsFixed thành Status -->
                                        @if (log.Status == "Đã vá" || log.Status == "Đã khắc phục")
                                        {
                                            <span style="color: #3fb950; font-size: 0.9rem;"><i class="fa-solid fa-circle-check me-1"></i> @log.Status</span>
                                        }
                                        else
                                        {
                                            <span style="color: #ff7b72; font-size: 0.9rem;"><i class="fa-solid fa-circle-xmark me-1"></i> @log.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5" style="color: #8b949e;">
                                    <i class="fa-solid fa-shield-cat fa-2x mb-3 opacity-50"></i><br />
                                    Hệ thống chưa ghi nhận bản ghi nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="cyber-panel d-flex flex-column">
            <div class="cyber-panel-title"><i class="fa-solid fa-server me-2" style="color: #d29922;"></i> Tài Nguyên Hệ Thống</div>
            <div class="flex-grow-1 d-flex flex-column justify-content-center gap-4">
                <div>
                    <div class="d-flex justify-content-between text-light mb-2">
                        <small>CPU Core</small>
                        <small style="color: #58a6ff;" id="cpu-text">45%</small>
                    </div>
                    <div class="cyber-progress">
                        <div id="cpu-bar" class="progress-bar" style="width: 45%; background-color: #58a6ff;"></div>
                    </div>
                </div>
                <div>
                    <div class="d-flex justify-content-between text-light mb-2">
                        <small>Memory (RAM)</small>
                        <small style="color: #3fb950;" id="ram-text">6.2 / 16 GB</small>
                    </div>
                    <div class="cyber-progress">
                        <div id="ram-bar" class="progress-bar" style="width: 38%; background-color: #3fb950;"></div>
                    </div>
                </div>
                <div>
                    <div class="d-flex justify-content-between text-light mb-2">
                        <small>Network Traffic</small>
                        <small style="color: #ff7b72;" id="net-text">95% (Cảnh báo)</small>
                    </div>
                    <div class="cyber-progress">
                        <div id="net-bar" class="progress-bar" style="width: 95%; background-color: #ff7b72;"></div>
                    </div>
                </div>
            </div>

            <!-- Nút quét được gói trong thẻ form -->
            <form method="post" asp-page-handler="RunScan">
                <button type="submit" class="btn w-100 mt-4 fw-bold" style="background: rgba(88, 166, 255, 0.1); color: #58a6ff; border: 1px solid #58a6ff; padding: 12px;">
                    <i class="fa-solid fa-radar me-2"></i> KHỞI ĐỘNG QUÉT TOÀN DIỆN
                </button>
            </form>

        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="cyber-panel">
            <div class="cyber-panel-title"><i class="fa-solid fa-chart-line me-2" style="color: #58a6ff;"></i> LƯU LƯỢNG TẤN CÔNG (7 NGÀY QUA)</div>
            <div style="height: 250px;"><canvas id="attackLineChart"></canvas></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="cyber-panel">
            <div class="cyber-panel-title"><i class="fa-solid fa-virus me-2" style="color: #ff7b72;"></i> PHÂN LOẠI LỖ HỔNG</div>
            <div style="height: 250px; display: flex; justify-content: center; align-items: center;"><canvas id="vulnDoughnutChart"></canvas></div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        Chart.defaults.color = '#8b949e';
        const lineCtx = document.getElementById('attackLineChart').getContext('2d');
        let gradientRed = lineCtx.createLinearGradient(0, 0, 0, 400);
        gradientRed.addColorStop(0, 'rgba(255, 123, 114, 0.3)');
        gradientRed.addColorStop(1, 'rgba(255, 123, 114, 0.0)');
        new Chart(lineCtx, {
            type: 'line',
            data: {
                labels: ['Thứ 2', 'Thứ 3', 'Thứ 4', 'Thứ 5', 'Thứ 6', 'Thứ 7', 'CN'],
                datasets: [{ label: 'Lượt truy cập độc hại', data: [120, 190, 80, 250, 110, 310, 140], borderColor: '#ff7b72', backgroundColor: gradientRed, borderWidth: 3, tension: 0.4, fill: true, pointBackgroundColor: '#161b22', pointBorderColor: '#ff7b72' }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { grid: { color: '#30363d' } }, y: { grid: { color: '#30363d' }, beginAtZero: true } } }
        });

        const doughnutCtx = document.getElementById('vulnDoughnutChart').getContext('2d');
        new Chart(doughnutCtx, {
            type: 'doughnut',
            data: { labels: ['SQL Injection', 'XSS', 'DDoS', 'Mã độc khác'], datasets: [{ data: [45, 25, 20, 10], backgroundColor: ['#ff7b72', '#d29922', '#58a6ff', '#3fb950'], borderColor: '#161b22', borderWidth: 3 }] },
            options: { responsive: true, maintainAspectRatio: false, cutout: '70%', plugins: { legend: { position: 'bottom' } } }
        });

        setInterval(function () {
            let cpu = Math.floor(Math.random() * (55 - 40 + 1)) + 40;
            document.getElementById("cpu-text").innerText = cpu + "%";
            document.getElementById("cpu-bar").style.width = cpu + "%";
            let ram = (Math.random() * (6.7 - 6.1) + 6.1).toFixed(1);
            let ramPercent = Math.floor((ram / 16) * 100);
            document.getElementById("ram-text").innerText = ram + " / 16 GB";
            document.getElementById("ram-bar").style.width = ramPercent + "%";
        }, 2000);
    });
</script>